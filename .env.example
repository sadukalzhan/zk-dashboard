# Google Sheets API key (required for production). Restrict to Sheets API in GCP console.
GOOGLE_SHEETS_API_KEY=

# Settings panel password (admin). Generate a strong one.
ADMIN_PASSWORD=change-me-please

# Optional: separate HMAC secret for signing the admin cookie.
# If not set, ADMIN_PASSWORD is reused.
ADMIN_SECRET=

# Cache TTL in ms (default 15 minutes).
CACHE_TTL_MS=900000

# Optional: Upstash Redis for storing sources list in production (Vercel-friendly).
# If not set, sources are persisted to the local file system (data/sources.json) — fine for local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
