# Google Sheets auth (pick ONE):
#  (a) Recommended: paste the full service-account JSON here (or base64-encoded).
#      Then share each Google Sheet with the service account's email (as Reader).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Finished products Google Sheets source.
GOOGLE_SHEETS_SPREADSHEET_ID=1limNj0Txl82lYeBrflyhpeckmvi9-xEkpb0QXcrhYro
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

#  (b) Alternative: API key (only works for sheets that are public via link).
GOOGLE_SHEETS_API_KEY=

# Settings panel password (admin). Generate a strong one.
ADMIN_PASSWORD=change-me-please

# Optional: separate HMAC secret for signing the admin cookie.
# If not set, ADMIN_PASSWORD is reused.
ADMIN_SECRET=

# Cache TTL in ms (default 15 minutes).
CACHE_TTL_MS=900000

# Optional: Upstash Redis for storing sources list in production (Vercel-friendly).
# If not set, sources are persisted to the local file system (data/sources.json) — fine for local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
